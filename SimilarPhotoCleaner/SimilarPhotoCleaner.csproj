<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SimilarPhotoCleaner</AssemblyName>
    <RootNamespace>SimilarPhotoCleaner</RootNamespace>
    <Product>비슷한 사진 정리기</Product>
    <AssemblyTitle>비슷한 사진 정리기</AssemblyTitle>
    <Version>1.6.0</Version>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 파일 속성의 제품 버전에 git 커밋 번호(+abc123)를 붙이지 않는다 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
